#include <winver.h>

// Path to icon
IDI_ICON1 ICON "assets/Sonder.ico"

// App info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Sonder"
            VALUE "ProductName",      "Sonder"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "CompanyName",      "Sonight"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sonight"
            VALUE "OriginalFilename", "Sonder.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END